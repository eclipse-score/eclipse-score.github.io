module(
    name = "score_platform",
)

###############################################################################
#
# Python version
#
###############################################################################
bazel_dep(name = "rules_python", version = "1.8.5")

PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

###############################################################################
#
# pip dependencies
#
###############################################################################
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_sphinx",
    python_version = PYTHON_VERSION,
    requirements_lock = "@score_docs_as_code//src:requirements.txt",
)
use_repo(pip, "pip_sphinx")

###############################################################################
#
# Provides documentation build & publishing
#
###############################################################################
bazel_dep(name = "score_docs_as_code", version = "7.1.0")

###############################################################################
#
# Other deps
#
###############################################################################
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_java", version = "8.15.1")

###############################################################################
#
# Generic linting and formatting rules
#
###############################################################################
bazel_dep(name = "aspect_rules_lint", version = "1.0.3")

###############################################################################
#
# Provides formatting binaries and tools
#
###############################################################################
bazel_dep(name = "score_devcontainer", version = "1.10.0", dev_dependency = True)
